{
  "name": "paseo-plugin-devkit",
  "version": "0.2.0",
  "description": "Unofficial dev kit for Paseo plugin authors: isolated dev daemon, host-contract checks, a scripted fake agent, web UI screenshots, registry and release helpers, plus a Claude Code skill.",
  "keywords": [
    "paseo",
    "paseo-plugin",
    "cli",
    "claude-code",
    "devtools",
    "testing",
    "playwright",
    "hermes"
  ],
  "homepage": "https://github.com/nkwib/paseo-plugin-devkit#readme",
  "bugs": {
    "url": "https://github.com/nkwib/paseo-plugin-devkit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nkwib/paseo-plugin-devkit.git"
  },
  "license": "MIT AND Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "ppd": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./vitest": {
      "types": "./dist/vitest.d.ts",
      "default": "./dist/vitest.js"
    },
    "./web": {
      "types": "./dist/web.d.ts",
      "default": "./dist/web.js"
    }
  },
  "files": [
    "dist",
    "scripts",
    "skills",
    "examples",
    "templates",
    "assets",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepare": "npm run build"
  },
  "dependencies": {
    "esbuild": "^0.28.2",
    "playwright-core": "^1.64.1",
    "semver": "^7.8.5"
  },
  "peerDependencies": {
    "vitest": ">=3"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "~22.20.5",
    "@types/semver": "^7.8.0",
    "typescript": "~7.0.2",
    "vitest": "^5.0.5"
  }
}
